---
const base = import.meta.env.BASE_URL;
---
<footer class="pt-16 pb-8 bg-mint border-t border-honeydew">
  <div class="max-w-7xl mx-auto px-6">
    <div class="pb-12 border-b border-sage/20">
      <a href="/" aria-label="Eightwire home" class="inline-block mb-6">
        <img src={`${base}images/eightwire-logo.svg`} alt="Eightwire" class="h-7 w-auto">
      </a>
      <p class="text-forest/50 text-sm body-relaxed mb-6 max-w-md">Experience fast, secure and easy data exchange with Eightwire's purpose-built products designed to streamline information sharing between systems.</p>
      <a href="https://www.linkedin.com/company/eight-wire-limited/" target="_blank" rel="noopener noreferrer" aria-label="Eightwire on LinkedIn" class="inline-flex items-center gap-2 text-forest/50 text-sm font-medium mb-6 hover:text-forest focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime focus-visible:ring-offset-2 rounded transition-colors">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
        LinkedIn
      </a>
      <div class="flex flex-wrap gap-3">
        <span class="inline-flex items-center gap-1 text-forest/30 text-[10px] font-medium">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
          NZISM
        </span>
        <span class="inline-flex items-center gap-1 text-forest/30 text-[10px] font-medium">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
          ISO 27001
        </span>
        <span class="inline-flex items-center gap-1 text-forest/30 text-[10px] font-medium">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
          SOC 2
        </span>
      </div>
    </div>
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-forest/30 text-xs">Copyright Eightwire Ltd. &copy; 2025 All rights reserved.</p>
      <p class="text-forest/30 text-xs">Level 4, 40 Taranaki Street, Wellington 6011, New Zealand</p>
    </div>
  </div>
</footer>
