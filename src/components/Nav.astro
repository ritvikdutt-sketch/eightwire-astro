---
const base = import.meta.env.BASE_URL;
---
<nav class="nav-bar fixed top-0 left-0 right-0 z-50" id="mainNav">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" aria-label="Eightwire home" class="flex-shrink-0 relative">
      <img src={`${base}images/eightwire-logo-white.svg`} alt="Eightwire" class="nav-logo-white h-8 w-auto">
      <img src={`${base}images/eightwire-logo.svg`} alt="Eightwire" class="nav-logo-dark h-8 w-auto top-0 left-0">
    </a>
    <div class="hidden lg:flex items-center gap-8">
    </div>
    <button id="menuBtn" class="nav-hamburger lg:hidden p-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime rounded" aria-label="Open menu">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>
</nav>

<div id="heroSentinel" class="absolute top-0 h-1"></div>
