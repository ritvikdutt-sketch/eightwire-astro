---
const base = import.meta.env.BASE_URL;
---
<div id="mobileMenu" class="mobile-overlay fixed inset-0 z-[60] bg-white flex flex-col items-center justify-center gap-8">
  <button id="menuClose" class="absolute top-5 right-6 p-2 text-forest" aria-label="Close menu">
    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <a href={base} class="text-2xl font-display text-forest" onclick="closeMobile()">Home</a>
</div>
