---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Eightwire | About" description="Learn about Eightwire's mission to connect people and organisations through the transformative potential of data.">

  <!-- ========== HERO ========== -->
  <section class="relative py-32 lg:py-44 overflow-hidden" style="background: #0c2e24;">
    <div class="absolute inset-0">
      <img src="/hero22.png" alt="" class="w-full h-full object-cover" aria-hidden="true">
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <div class="reveal">
        <p class="text-lime font-bold text-xs tracking-[0.2em] uppercase mb-5">About Us</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.1] mb-6">About Eightwire</h1>
        <p class="text-white/75 text-lg sm:text-xl body-relaxed max-w-2xl mx-auto">We believe great things happen when data is shared.</p>
      </div>
    </div>
  </section>

  <!-- ========== MISSION ========== -->
  <section class="py-24 lg:py-32 bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="reveal">
        <div class="px-8 sm:px-10 py-10 sm:py-12" style="background: rgba(20,80,65,0.03); border: 1px solid rgba(20,80,65,0.08); border-radius: 1rem;">
          <p class="text-lime-mid font-bold text-xs tracking-[0.2em] uppercase mb-4">Our Mission</p>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl text-forest leading-[1.15] mb-8">We believe great things happen when data is shared.</h2>
          <p class="text-forest-light text-lg body-relaxed max-w-3xl mx-auto">Our mission at Eightwire is to connect people and organisations through the transformative potential of data.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DO ========== -->
  <section class="py-24 lg:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <div class="px-8 sm:px-10 py-10 sm:py-12" style="background: rgba(20,80,65,0.03); border: 1px solid rgba(20,80,65,0.08); border-radius: 1rem;">
            <p class="text-lime-mid font-bold text-xs tracking-[0.2em] uppercase mb-4">What We Do</p>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl text-forest leading-[1.15] mb-6">Automating the exchange of information</h2>
            <p class="text-forest-light text-lg body-relaxed">We automate the exchange of information between data systems to accelerate business performance while reducing costs, time and risks.</p>
          </div>
        </div>
        <div class="reveal reveal-delay-2 relative">
          <div class="rounded-2xl overflow-hidden relative" style="box-shadow: 0 4px 24px rgba(20,80,65,0.08), 0 1px 4px rgba(20,80,65,0.06);">
            <img src="https://placehold.co/600x450/d6e9e2/145041?text=Data+Systems" alt="Data systems illustration" class="w-full h-auto">
            <div class="absolute inset-0 bg-gradient-to-t from-forest/20 to-transparent mix-blend-multiply"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SECONDARY MISSION ========== -->
  <section class="py-24 lg:py-32 relative overflow-hidden" style="background: linear-gradient(170deg, #145041 0%, #0c372c 100%);">
    <div class="absolute inset-0 grain" style="opacity: 0.5;"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <div class="reveal">
        <div class="px-8 sm:px-10 py-10 sm:py-12" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.1); border-radius: 1rem;">
          <div class="w-16 h-16 rounded-2xl bg-lime/15 flex items-center justify-center mx-auto mb-8">
            <svg class="w-8 h-8 text-lime" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-.778.099-1.533.284-2.253"/></svg>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] text-white leading-[1.2] mb-6">Transforming health and social services delivery</h2>
          <p class="text-white/75 text-lg body-relaxed max-w-3xl mx-auto">At Eightwire, we're on a mission to simplify, secure and automate data exchange, transforming the way that health and social services are delivered across New Zealand.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== TRUSTED ========== -->
  <section class="py-24 lg:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <div class="px-8 sm:px-10 py-10 sm:py-12" style="background: rgba(20,80,65,0.03); border: 1px solid rgba(20,80,65,0.08); border-radius: 1rem;">
        <div class="reveal">
          <p class="text-lime-mid font-bold text-xs tracking-[0.2em] uppercase mb-4">Our Partners</p>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl text-forest leading-[1.15] mb-12">Trusted to handle high-stakes data</h2>
        </div>
        <div class="reveal reveal-delay-1 flex flex-wrap items-center justify-center gap-8 lg:gap-16 mb-12 opacity-40">
          <img src="https://placehold.co/140x50/145041/145041?text=." alt="Trust partner logo" class="h-8 grayscale">
          <img src="https://placehold.co/140x50/145041/145041?text=." alt="Trust partner logo" class="h-8 grayscale">
          <img src="https://placehold.co/140x50/145041/145041?text=." alt="Trust partner logo" class="h-8 grayscale">
          <img src="https://placehold.co/140x50/145041/145041?text=." alt="Trust partner logo" class="h-8 grayscale">
          <img src="https://placehold.co/140x50/145041/145041?text=." alt="Trust partner logo" class="h-8 grayscale">
          <img src="https://placehold.co/140x50/145041/145041?text=." alt="Trust partner logo" class="h-8 grayscale">
        </div>
        <p class="reveal reveal-delay-2 text-forest-light text-lg body-relaxed">Trusted by over 100 public and private organisations to securely exchange sensitive data every day.</p>
      </div>
    </div>
  </section>

  <!-- ========== CTA ========== -->
  <section class="py-24 lg:py-32 relative overflow-hidden" style="background: linear-gradient(170deg, #145041 0%, #0c372c 100%);">
    <div class="absolute inset-0 grain" style="opacity: 0.5;"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <div class="reveal">
        <div class="px-8 sm:px-10 py-10 sm:py-12" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.1); border-radius: 1rem;">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl text-white leading-[1.15] mb-8">Find out how we can help you exchange data fast</h2>
          <a href="/contact" class="inline-flex items-center gap-3 bg-lime text-forest font-semibold px-8 py-4 rounded-full btn-press focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime focus-visible:ring-offset-2 focus-visible:ring-offset-forest text-lg" style="box-shadow: 0 4px 20px rgba(129,215,19,0.3), 0 1px 3px rgba(129,215,19,0.2);">
            Chat to the team
            <svg width="16" height="16" viewBox="0 0 18 18" fill="none"><path d="M4.43 1.64L14.33 1.64M14.33 1.64L14.33 11.54M14.33 1.64L1.61 14.36" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
