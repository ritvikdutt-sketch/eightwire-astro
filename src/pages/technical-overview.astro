---
import LandingLayout from '../layouts/LandingLayout.astro';
import PageHero from '../components/landing/PageHero.tsx';
import SectionHead from '../components/landing/SectionHead.tsx';
import FeatureColumns from '../components/landing/FeatureColumns.tsx';
import Steps from '../components/landing/Steps.tsx';
import CTASection from '../components/landing/CTASection.tsx';
import { btnForest, arrowNudge, focusForest } from '../components/landing/ui';
import { BOOK_DEMO_HREF, BOOK_DEMO_LABEL } from '../components/landing/cta';

const base = import.meta.env.BASE_URL;

// Copy carried over verbatim from eightwire.io/technical-overview.
const DESCRIPTION =
  "Discover how Eightwire's secure data-sharing platform works. Safe, secure and easy data exchange across boundaries with end-to-end security and no-code integration.";

const CAPABILITIES = [
  { icon: 'shield', title: 'Create a safe and secure environment', body: 'Ensure you meet user access, data sovereignty, governance, privacy, and other security requirements.' },
  { icon: 'layers', title: 'Move on-premise data to cloud-based systems', body: 'Our platform lets you easily populate cloud-based data warehouse platforms from on-premises systems, removing the need to build bespoke integrations.' },
  { icon: 'clock', title: 'Connect legacy systems and SaaS products', body: 'Deploy data sharing features for enterprise SaaS products that rely on sensitive data from legacy systems, without the need for APIs, manual extracts or other complex technologies.' },
  { icon: 'check', title: 'Share data across silos', body: 'Share sensitive information across separate divisions, partners and customers without the need to upgrade systems.' },
] as const;
---
<LandingLayout title="Technical overview — Eightwire" description={DESCRIPTION}>
  <PageHero
    eyebrow="About · Technical overview"
    lede="We work with technology partners providing a vital component to your data-driven services, often minimising the thousands of steps required to access, validate and move data."
  >
    Safe, secure and easy data-sharing <em class="text-lime">across boundaries</em>
  </PageHero>

  <!-- Our approach -->
  <section
    class="border-b border-cream-line pt-24 pb-10 sm:pt-28 sm:pb-12"
    style="background: radial-gradient(ellipse 80% 60% at 15% 40%, rgba(129,215,19,0.06) 0%, transparent 60%), #F5F4EE;"
  >
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <SectionHead
        eyebrow="Our approach"
        lede="We automate the movement and management of sensitive data. Our products remove the majority of the work for customers to share data across boundaries while maintaining end-to-end security."
      >
        Where security meets <em class="text-forest">convenience</em>
      </SectionHead>
    </div>
  </section>

  <FeatureColumns eyebrow="Capabilities" items={CAPABILITIES}>
    What can Eightwire <em class="text-forest">help you do?</em>
  </FeatureColumns>

  <Steps />

  <!-- Position -->
  <section
    class="relative overflow-hidden border-b border-lime/10 py-24 sm:py-28"
    style="background: radial-gradient(ellipse 70% 60% at 85% 20%, rgba(129,215,19,0.08) 0%, transparent 60%), #0A1F14;"
  >
    <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
      <SectionHead eyebrow="Our position" dark>
        A <em class="text-lime">trusted intermediary</em> between all parties
      </SectionHead>
      <div class="reveal -mt-6 grid lg:grid-cols-[0.38fr_1fr] lg:gap-14">
        <div class="hidden lg:block" aria-hidden="true"></div>
        <p class="max-w-2xl text-lede leading-[1.7] text-cream/70">
          We operate in sectors that often have conflicted relationships. Eightwire remains unencumbered by technical and business relationships to function as a trusted intermediary between all parties.
        </p>
      </div>
    </div>
  </section>

  <!-- Integrations -->
  <section
    class="border-b border-cream-line py-24 sm:py-28"
    style="background: radial-gradient(ellipse 80% 60% at 85% 40%, rgba(214,237,216,0.5) 0%, transparent 55%), #EDEBE2;"
  >
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <SectionHead
        eyebrow="Connectors"
        lede="We work closely with a range of sectors that have significant and complex data exchange needs. Our data sharing products integrate with a majority of commonly used databases."
      >
        <em class="text-forest">Integrations</em> for the systems you already run
      </SectionHead>
      <div class="reveal -mt-6 grid lg:grid-cols-[0.38fr_1fr] lg:gap-14">
        <div class="hidden lg:block" aria-hidden="true"></div>
        <div class="flex flex-wrap gap-3">
          <a href={`${base}connectors/`} class={btnForest}>
            Browse all connectors
            <span aria-hidden="true" class={arrowNudge}>→</span>
          </a>
          <a href={BOOK_DEMO_HREF} class={`group inline-flex items-center gap-2 rounded-sm border border-forest/25 px-6 py-3 text-body-sm font-medium text-forest transition-colors duration-200 hover:border-forest/60 ${focusForest}`}>
            {BOOK_DEMO_LABEL}
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</LandingLayout>
