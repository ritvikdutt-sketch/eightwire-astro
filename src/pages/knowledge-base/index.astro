---
import { getCollection } from 'astro:content';
import LandingLayout from '../../layouts/LandingLayout.astro';
import PageHero from '../../components/landing/PageHero.tsx';
import CTASection from '../../components/landing/CTASection.tsx';
import KbBrowser from '../../components/kb/KbBrowser.tsx';
import { CONTACT_EMAIL } from '../../components/landing/cta';

const base = import.meta.env.BASE_URL;

// Lede carried over verbatim from eightwire.io/knowledge-base.
const LEDE = 'Learning resources to get you started using Eightwire, for administrators and end-users';

const entries = (await getCollection('kb')).sort((a, b) => a.data.order - b.data.order);
const categories = [...new Set(entries.map((e) => e.data.category))];
const articles = entries.map((e) => ({
  slug: e.id,
  title: e.data.title,
  description: e.data.description,
  category: e.data.category,
  order: e.data.order,
}));
---
<LandingLayout title="Knowledge base — Eightwire" description={`${LEDE}.`}>
  <PageHero eyebrow="Resources · Knowledge base" lede={LEDE}>
    Knowledge <em class="text-lime">base</em>
    <p slot="actions" class="font-mono text-caption uppercase tracking-[0.14em] text-cream/55">
      {articles.length} articles · {categories.length} topics
    </p>
  </PageHero>

  <section
    class="border-b border-cream-line py-16 sm:py-20"
    style="background: radial-gradient(ellipse 80% 60% at 15% 40%, rgba(129,215,19,0.06) 0%, transparent 60%), #F5F4EE;"
  >
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <KbBrowser client:load articles={articles} categories={categories} base={base} supportEmail={CONTACT_EMAIL} />
    </div>
  </section>

  <CTASection />
</LandingLayout>
