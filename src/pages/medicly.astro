---
import LandingLayout from '../layouts/LandingLayout.astro';
import PageHero from '../components/landing/PageHero.tsx';
import SectionHead from '../components/landing/SectionHead.tsx';
import FeatureColumns from '../components/landing/FeatureColumns.tsx';
import HandoffBand from '../components/landing/HandoffBand.tsx';
import CTASection from '../components/landing/CTASection.tsx';
import { PLATFORM_LEDE } from '../components/landing/Platform.tsx';
import { btnPrimary, btnGhostDark } from '../components/landing/ui';

const base = import.meta.env.BASE_URL;

// Copy carried over verbatim from the previous Medicly page.
const LEDE = 'Health and social systems can access health data faster and more securely than before with Medicly.';
const DESCRIPTION =
  "Medicly is Eightwire's all-round solution for sensitive health data exchange. Health and social systems can access health data faster and more securely than before.";
const OVERVIEW =
  'Take the complexity out of data-sharing between healthcare technologies with our automated, safe and secure data exchange. Medicly enables the delivery of data from any system while removing the technical, security and compliance obstacles that get in the way.';
const FEATURES = [
  { icon: 'layers', title: 'Integration', body: 'System integration without the need for APIs, manual extracts or other complex technologies.' },
  { icon: 'clock', title: 'Automation', body: 'Automated error correction for thousands of common data errors to reduce system crashes.' },
  { icon: 'shield', title: 'Security', body: 'We meet the highest security thresholds required for data sharing across the public internet.' },
  { icon: 'check', title: 'Compliance', body: 'Meet compliance with ease through our security controls that automatically reduce the effort in adhering to privacy and security standards.' },
] as const;
---
<LandingLayout
  title="Medicly — Eightwire"
  description={DESCRIPTION}
  ogDescription="Medicly is Eightwire's all-round solution for sensitive health data exchange."
>
  <PageHero eyebrow="Products · Medicly" lede={LEDE}>
    An all-round solution for <em class="text-lime">sensitive health data</em> exchange
    <div slot="actions" class="flex flex-wrap gap-3">
      <a href="https://www.medicly.co.nz/" target="_blank" rel="noopener noreferrer" class={btnPrimary}>
        Visit medicly.co.nz
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
          <path d="M4.43 1.64L14.33 1.64M14.33 1.64L14.33 11.54M14.33 1.64L1.61 14.36" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
      <a href="#contact" class={btnGhostDark}>Talk to us</a>
    </div>
  </PageHero>

  <!-- Overview -->
  <section
    class="border-b border-cream-line pt-24 pb-10 sm:pt-28 sm:pb-12"
    style="background: radial-gradient(ellipse 80% 60% at 15% 40%, rgba(129,215,19,0.06) 0%, transparent 60%), #F5F4EE;"
  >
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <SectionHead eyebrow="Overview" lede={OVERVIEW}>
        Data-sharing in the health sector <em class="text-forest">made simple and secure</em>
      </SectionHead>
    </div>
  </section>

  <FeatureColumns eyebrow="Why Medicly" items={FEATURES}>
    Built for the <em class="text-forest">health sector</em>
  </FeatureColumns>

  <HandoffBand eyebrow="Conductor" lede={PLATFORM_LEDE} cta={{ label: 'Explore Conductor', href: `${base}conductor/` }}>
    Medicly is built on <em class="text-lime">Conductor</em> for NZ health
  </HandoffBand>

  <CTASection />
</LandingLayout>
