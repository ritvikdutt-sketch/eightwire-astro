---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Medicly | Health Data Exchange | Eightwire" description="Medicly is Eightwire's all-round solution for sensitive health data exchange. Health and social systems can access health data faster and more securely than before.">

  <!-- ========== HERO ========== -->
  <section class="relative pt-32 pb-24 lg:pt-44 lg:pb-32 overflow-hidden" style="background: #0c2e24;">
    <div class="absolute inset-0">
      <img src="/hero22.png" alt="" class="w-full h-full object-cover" aria-hidden="true">
    </div>
    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
      <!-- Medicly logo -->
      <div class="mb-10 reveal">
        <img src="/images/Frame-19965medically-1.svg" alt="Medicly" class="mx-auto h-14 sm:h-16 w-auto">
      </div>

      <h1 class="font-display heading-tight text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.1] mb-6 reveal reveal-delay-1">
        An all-round solution for sensitive health data exchange
      </h1>

      <p class="text-white/75 body-relaxed text-lg sm:text-xl max-w-2xl mx-auto mb-10 reveal reveal-delay-2">
        Health and social systems can access health data faster and more securely than before with Medicly.
      </p>

      <div class="reveal reveal-delay-3">
        <a href="https://www.medicly.co.nz" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-lime text-forest font-semibold px-8 py-4 rounded-full btn-press focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime focus-visible:ring-offset-2 focus-visible:ring-offset-forest" style="box-shadow: 0 4px 14px rgba(129,215,19,0.3), 0 1px 3px rgba(129,215,19,0.2);">
          Visit medicly.co.nz
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4.43 1.64L14.33 1.64M14.33 1.64L14.33 11.54M14.33 1.64L1.61 14.36" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

    <!-- Decorative radial gradients -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[800px] rounded-full opacity-20" style="background: radial-gradient(circle, rgba(129,215,19,0.15) 0%, transparent 70%);"></div>
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] rounded-full opacity-10" style="background: radial-gradient(circle, rgba(214,233,226,0.2) 0%, transparent 70%);"></div>
  </section>

  <!-- ========== TESTIMONIAL ========== -->
  <section class="py-24 lg:py-32 relative overflow-hidden grain" style="background: linear-gradient(170deg, #145041 0%, #0c372c 100%);">
    <div class="max-w-4xl mx-auto px-6 relative z-10">
      <div class="reveal" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.1); border-radius: 1rem; padding: 2.5rem;">
        <!-- Decorative quote mark -->
        <div class="mb-8">
          <svg width="64" height="48" viewBox="0 0 64 48" fill="none" class="opacity-20">
            <path d="M0 48V28.8C0 21.12 1.28 14.88 3.84 10.08C6.4 5.28 10.88 1.6 17.28 0L20.48 6.72C16.64 8 13.76 10.08 11.84 12.96C9.92 15.84 8.96 19.2 8.96 23.04H17.92V48H0ZM35.84 48V28.8C35.84 21.12 37.12 14.88 39.68 10.08C42.24 5.28 46.72 1.6 53.12 0L56.32 6.72C52.48 8 49.6 10.08 47.68 12.96C45.76 15.84 44.8 19.2 44.8 23.04H53.76V48H35.84Z" fill="#81D713"/>
          </svg>
        </div>

        <blockquote class="font-display heading-tight text-2xl sm:text-3xl lg:text-4xl text-white leading-[1.25] mb-8">
          Medicly works seamlessly with your PMS, ensuring that data is secure in transit and is only used for the specific purpose for which it has been approved.
        </blockquote>

        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-lime/20 flex items-center justify-center">
            <span class="text-lime font-semibold text-lg">GS</span>
          </div>
          <div>
            <p class="font-semibold text-white">Geoffrey Sayer</p>
            <p class="text-white/60 text-sm">CEO, Medtech Global</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== OVERVIEW ========== -->
  <section class="py-24 lg:py-32 bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="reveal" style="background: rgba(20,80,65,0.03); border: 1px solid rgba(20,80,65,0.08); border-radius: 1rem; padding: 2rem;">
          <p class="text-lime-mid font-bold text-xs tracking-[0.2em] uppercase mb-3">Overview</p>
          <h2 class="font-display heading-tight text-3xl sm:text-4xl lg:text-[2.75rem] text-forest leading-[1.15] mb-6">
            Data-sharing in the health sector made simple and secure
          </h2>
        </div>
        <div class="reveal reveal-delay-2" style="background: rgba(20,80,65,0.03); border: 1px solid rgba(20,80,65,0.08); border-radius: 1rem; padding: 2rem;">
          <p class="text-forest-light body-relaxed text-lg">
            Take the complexity out of data-sharing between healthcare technologies with our automated, safe and secure data exchange. Medicly enables the delivery of data from any system while removing the technical, security and compliance obstacles that get in the way.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY MEDICLY — FEATURE CARDS ========== -->
  <section class="py-24 lg:py-32 bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16 reveal" style="background: rgba(20,80,65,0.03); border: 1px solid rgba(20,80,65,0.08); border-radius: 1rem; padding: 2rem;">
        <p class="text-lime-mid font-bold text-xs tracking-[0.2em] uppercase mb-3">Why Medicly</p>
        <h2 class="font-display heading-tight text-3xl sm:text-4xl text-forest leading-[1.15]">
          Built for the health sector
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-6 lg:gap-8">
        <!-- Integration -->
        <div class="reveal rounded-2xl p-8 lg:p-10 " style="background: rgba(20,80,65,0.03); border: 1px solid rgba(20,80,65,0.08); box-shadow: 0 2px 8px rgba(20,80,65,0.04), 0 8px 32px rgba(20,80,65,0.06);">
          <div class="w-12 h-12 rounded-xl bg-forest/10 flex items-center justify-center mb-6">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#145041" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3 class="font-display heading-tight text-xl text-forest mb-3">Integration</h3>
          <p class="text-forest-light body-relaxed">System integration without the need for APIs, manual extracts or other complex technologies.</p>
        </div>

        <!-- Automation -->
        <div class="reveal reveal-delay-1 rounded-2xl p-8 lg:p-10 " style="background: rgba(20,80,65,0.03); border: 1px solid rgba(20,80,65,0.08); box-shadow: 0 2px 8px rgba(20,80,65,0.04), 0 8px 32px rgba(20,80,65,0.06);">
          <div class="w-12 h-12 rounded-xl bg-forest/10 flex items-center justify-center mb-6">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#145041" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 8V12l3 3"/><circle cx="12" cy="12" r="10"/>
            </svg>
          </div>
          <h3 class="font-display heading-tight text-xl text-forest mb-3">Automation</h3>
          <p class="text-forest-light body-relaxed">Automated error correction for thousands of common data errors to reduce system crashes.</p>
        </div>

        <!-- Security -->
        <div class="reveal reveal-delay-2 rounded-2xl p-8 lg:p-10 " style="background: rgba(20,80,65,0.03); border: 1px solid rgba(20,80,65,0.08); box-shadow: 0 2px 8px rgba(20,80,65,0.04), 0 8px 32px rgba(20,80,65,0.06);">
          <div class="w-12 h-12 rounded-xl bg-forest/10 flex items-center justify-center mb-6">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#145041" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="font-display heading-tight text-xl text-forest mb-3">Security</h3>
          <p class="text-forest-light body-relaxed">We meet the highest security thresholds required for data sharing across the public internet.</p>
        </div>

        <!-- Compliance -->
        <div class="reveal reveal-delay-3 rounded-2xl p-8 lg:p-10 " style="background: rgba(20,80,65,0.03); border: 1px solid rgba(20,80,65,0.08); box-shadow: 0 2px 8px rgba(20,80,65,0.04), 0 8px 32px rgba(20,80,65,0.06);">
          <div class="w-12 h-12 rounded-xl bg-forest/10 flex items-center justify-center mb-6">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#145041" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
            </svg>
          </div>
          <h3 class="font-display heading-tight text-xl text-forest mb-3">Compliance</h3>
          <p class="text-forest-light body-relaxed">Meet compliance with ease through our security controls that automatically reduce the effort in adhering to privacy and security standards.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== CTA SECTION ========== -->
  <section class="py-24 lg:py-32 relative grain" style="background: linear-gradient(135deg, #145041 0%, #195a4a 100%);">
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <div class="reveal" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.1); border-radius: 1rem; padding: 3rem;">
        <h2 class="font-display heading-tight text-3xl sm:text-4xl lg:text-5xl text-white leading-[1.15] mb-10">
          Find out more about how Medicly can help
        </h2>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="mailto:hello@eightwire.co.nz" class="inline-flex items-center gap-3 bg-lime text-forest font-semibold px-8 py-4 rounded-full btn-press focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime focus-visible:ring-offset-2 focus-visible:ring-offset-forest" style="box-shadow: 0 4px 14px rgba(129,215,19,0.3), 0 1px 3px rgba(129,215,19,0.2);">
            Contact us
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M12 1.5L19 8.5M19 8.5L12 15.5M19 8.5L1 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="https://www.medicly.co.nz" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-white/10 text-white font-semibold px-8 py-4 rounded-full btn-press border border-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime focus-visible:ring-offset-2 focus-visible:ring-offset-forest" style="box-shadow: 0 4px 14px rgba(20,80,65,0.2); backdrop-filter: blur(6px);">
            Visit medicly.co.nz
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4.43 1.64L14.33 1.64M14.33 1.64L14.33 11.54M14.33 1.64L1.61 14.36" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Decorative gradient -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full opacity-10" style="background: radial-gradient(circle, rgba(129,215,19,0.2) 0%, transparent 70%);"></div>
  </section>

  <!-- ========== NEWSLETTER CTA ========== -->
  <section class="py-24 lg:py-32 relative overflow-hidden grain" style="background: linear-gradient(170deg, #145041 0%, #0c372c 100%);">
    <div class="max-w-5xl mx-auto px-6 relative z-10">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <div class="rounded-2xl overflow-hidden" style="box-shadow: 0 4px 24px rgba(0,0,0,0.2);">
            <img src="https://placehold.co/500x400/195a4a/81D713?text=Eightwire" alt="Eightwire illustration" class="w-full h-auto">
          </div>
        </div>
        <div class="reveal reveal-delay-2" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.1); border-radius: 1rem; padding: 2rem;">
          <p class="text-lime font-bold text-xs tracking-[0.2em] uppercase mb-3">The Wire</p>
          <h2 class="font-display heading-tight text-3xl sm:text-4xl text-white leading-[1.15] mb-4">Expand your bandwidth</h2>
          <p class="text-white/70 body-relaxed mb-8">Join our email newsletter for the latest on safe and secure data-sharing.</p>
          <form class="flex gap-3" onsubmit="event.preventDefault()">
            <input type="email" placeholder="Email address" required class="flex-1 px-5 py-3 rounded-full border border-white/20 bg-white/10 text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-lime focus:border-transparent text-sm">
            <button type="submit" class="bg-lime text-forest px-6 py-3 rounded-full font-semibold btn-press focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime focus-visible:ring-offset-2 text-sm" style="box-shadow: 0 2px 8px rgba(129,215,19,0.3);">
              Submit
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
