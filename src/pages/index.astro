---
import LandingLayout from '../layouts/LandingLayout.astro';
import Hero from '../components/landing/Hero.tsx';
import Stats from '../components/landing/Stats.tsx';
import Marquee from '../components/landing/Marquee.tsx';
import Problem from '../components/landing/Problem.tsx';
import Platform from '../components/landing/Platform.tsx';
import HowItWorks from '../components/landing/HowItWorks.tsx';
import Solutions from '../components/landing/Solutions.tsx';
import Security from '../components/landing/Security.tsx';
import CTASection from '../components/landing/CTASection.tsx';
---
<LandingLayout
  title="Eightwire — Secure data exchange for Aotearoa"
  description="Conductor by Eightwire moves sensitive data between health, government and enterprise systems. No custom code. No manual handling. No sovereignty compromises."
  ogDescription="Conductor by Eightwire moves sensitive data between health, government and enterprise systems."
>
  <Hero client:load />
  <Stats client:visible />
  <Marquee />
  <Problem />
  <Platform />
  <HowItWorks />
  <Solutions />
  <Security />
  <CTASection />
</LandingLayout>
