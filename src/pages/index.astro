---
import BackgroundScene from '../components/BackgroundScene.tsx';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Eightwire — Secure data exchange for Aotearoa</title>
<meta name="description" content="Conductor by Eightwire moves sensitive data between health, government and enterprise systems. No custom code. No manual handling. No sovereignty compromises." />
<meta property="og:title" content="Eightwire — Secure data exchange for Aotearoa" />
<meta property="og:description" content="Conductor by Eightwire moves sensitive data between health, government and enterprise systems." />
<meta property="og:type" content="website" />
<link rel="icon" href="/favicon.png" type="image/png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<style is:global>
:root {
  --green-900: #050F09;
  --green-800: #0A1F14;
  --green-700: #0F3A20;
  --green-600: #165A38;
  --green-300: #81D713;
  --green-300-hover: #93e820;
  --green-100: #D6EDD8;
  --cream: #F5F4EE;
  --cream-2: #EFEDE5;
  --ink: #080C0A;
  --ink-2: #252C28;
  --muted: #6A706C;
  --line: #D6D3C8;
  --line-soft: #E5E2D8;
}

/* ====== SKIP LINK (WCAG 2.4.1) ====== */
.skip-link {
  position: absolute; top: -100%; left: 16px;
  background: var(--green-300); color: var(--green-900);
  font-size: 14px; font-weight: 600; padding: 10px 18px;
  border-radius: 0 0 4px 4px; text-decoration: none; z-index: 9999;
  transition: top .15s;
}
.skip-link:focus { top: 0; }

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Inter', -apple-system, sans-serif;
  background: var(--cream);
  color: var(--ink);
  line-height: 1.65;
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  overflow-x: hidden;
}

/* ====== NAV ====== */
.nav-wrap {
  position: sticky; top: 0; z-index: 100;
  background: var(--green-900);
  border-bottom: 1px solid transparent;
  transition: background 0.45s cubic-bezier(0.22,1,0.36,1),
              border-color 0.45s cubic-bezier(0.22,1,0.36,1),
              box-shadow 0.45s cubic-bezier(0.22,1,0.36,1);
}
.nav-wrap.scrolled {
  background: rgba(5,15,9,0.88);
  backdrop-filter: blur(24px) saturate(1.6);
  -webkit-backdrop-filter: blur(24px) saturate(1.6);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  box-shadow: 0 1px 0 rgba(255,255,255,0.04) inset,
              0 4px 32px rgba(0,0,0,0.35);
}
/* Nav is always dark — consistent treatment */
.nav-wrap .nav-logo img { filter: none; }
.nav-wrap .nav-hamburger { color: rgba(235,234,228,0.85); }
.nav-wrap .btn:not(.btn-ghost) {
  background: var(--green-300); color: var(--green-900);
  border-color: var(--green-300); font-weight: 600;
}
.nav-wrap .btn:not(.btn-ghost):hover {
  background: var(--green-300-hover); border-color: var(--green-300-hover);
}
nav {
  max-width: 1280px; margin: 0 auto;
  padding: 16px 32px;
  display: flex; align-items: center; justify-content: space-between; gap: 24px;
}
.nav-logo img { height: 32px; width: auto; max-width: 180px; display: block; }
.nav-links { display: flex; gap: 28px; }
.nav-links a {
  font-size: 13.5px; color: rgba(235,234,228,0.75); text-decoration: none;
  position: relative; padding: 4px 0; transition: color .15s; letter-spacing: 0.005em;
}
.nav-links a:hover { color: var(--green-300); }
.nav-links a::after {
  content: ''; position: absolute; bottom: -2px; left: 50%;
  width: 0; height: 1.5px; background: var(--green-300);
  transition: width .25s cubic-bezier(0.22,1,0.36,1), left .25s cubic-bezier(0.22,1,0.36,1);
}
.nav-links a:hover::after { width: 100%; left: 0; }
.nav-right { display: flex; gap: 10px; align-items: center; flex-shrink: 0; }
.nav-signin {
  font-size: 13.5px; color: rgba(235,234,228,0.75); text-decoration: none;
  padding: 8px 14px; transition: color .15s;
}
.nav-signin:hover { color: var(--green-300); }
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 22px;
  background: var(--green-700); color: var(--cream);
  text-decoration: none; font-size: 13.5px; font-weight: 500;
  letter-spacing: 0.01em;
  border-radius: 3px; border: 1px solid var(--green-700);
  cursor: pointer;
  transition: background .18s, border-color .18s, transform .15s, box-shadow .18s;
}
.btn:hover {
  background: var(--green-600); border-color: var(--green-600);
  box-shadow: 0 4px 16px rgba(5,15,9,0.25);
}
.btn:active { transform: scale(0.97); }

/* ====== FOCUS-VISIBLE ====== */
:focus { outline: none; }
.btn:focus-visible { outline: 3px solid var(--green-300); outline-offset: 3px; }
/* nav is on dark bg — green-300 (#81D713) gives 10:1 ratio vs #050F09 */
.nav-links a:focus-visible, .nav-signin:focus-visible {
  outline: 2px solid var(--green-300); outline-offset: 3px; border-radius: 2px;
}
/* footer is on cream bg — green-700 (#0F3A20) gives 10.5:1 ratio vs #F5F4EE */
.footer-col a:focus-visible, .footer-bottom-links a:focus-visible,
.footer-linkedin:focus-visible {
  outline: 2px solid var(--green-700); outline-offset: 3px; border-radius: 2px;
}
.solution-link:focus-visible, .mobile-menu a:focus-visible {
  outline: 2px solid var(--green-700); outline-offset: 3px; border-radius: 2px;
}
.nav-hamburger:focus-visible, .mobile-menu-close:focus-visible, .back-to-top:focus-visible {
  outline: 2px solid var(--green-300); outline-offset: 3px; border-radius: 2px;
}

.btn-ghost { background: transparent; color: var(--green-700); border-color: currentColor; }
.btn-ghost:hover { background: var(--green-700); color: var(--cream); border-color: var(--green-700); }
.btn .arrow { transition: transform .2s; display: inline-block; }
.btn:hover .arrow { transform: translateX(3px); }
.nav-hamburger {
  display: none; background: none; border: none; cursor: pointer;
  padding: 6px; color: var(--ink-2);
}

/* ====== MOBILE MENU ====== */
.mobile-menu {
  position: fixed; inset: 0; z-index: 200;
  background: var(--cream);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28px;
  opacity: 0; pointer-events: none; transition: opacity .3s ease;
}
.mobile-menu.open { opacity: 1; pointer-events: auto; }
.mobile-menu-close {
  position: absolute; top: 20px; right: 24px;
  background: none; border: none; cursor: pointer; color: var(--ink-2); padding: 8px;
}
.mobile-menu a {
  font-family: 'Inter', sans-serif; font-size: 26px; color: var(--green-900);
  text-decoration: none; letter-spacing: -0.02em; transition: color .15s;
}
.mobile-menu a:hover { color: var(--green-700); }
.mobile-menu .btn { font-family: 'Inter', sans-serif; font-size: 14px; margin-top: 8px; }

/* ====== BACKGROUND SCENE ====== */
.scene {
  position: absolute; inset: 0;
  pointer-events: none; z-index: 0;
}
.floor {
  position: absolute; bottom: 0; left: 0;
  width: 100%; height: 55%;
  display: block;
}
.main-column {
  position: absolute; left: 50%; bottom: 0;
  transform: translateX(-50%);
  width: 2px; height: 55%;
  background: linear-gradient(to top,
    rgba(129,215,19,0.9) 0%,
    rgba(129,215,19,0.45) 35%,
    rgba(129,215,19,0.1) 70%,
    transparent 100%
  );
  filter: blur(0.5px);
}
.light-stream-container { position: absolute; inset: 0; }
.light-beam {
  position: absolute; bottom: -200px;
  height: 120px;
  background: linear-gradient(
    to top,
    transparent 0%,
    rgba(129,215,19,0.06) 20%,
    rgba(129,215,19,0.5) 50%,
    rgba(129,215,19,0.06) 80%,
    transparent 100%
  );
  border-radius: 1px;
  opacity: 0;
  animation-name: beam-rise, beam-fade, beam-drop;
  animation-timing-function: linear, ease-in-out, ease-in-out;
  animation-iteration-count: infinite, infinite, infinite;
}
@keyframes beam-rise {
  from { transform: translateY(0); }
  to   { transform: translateY(calc(-100vh - 200px)); }
}
@keyframes beam-fade {
  0%   { opacity: 0; }
  15%  { opacity: 1; }
  80%  { opacity: 0.7; }
  100% { opacity: 0; }
}
@keyframes beam-drop {
  0%, 100% { height: 40px; }
  40%       { height: 150px; }
  70%       { height: 120px; }
}

/* ====== DATA GRID HERO ====== */
@keyframes cell-pulse {
  from { opacity: var(--opacity-min, 0.03); }
  to   { opacity: var(--opacity-max, 0.18); }
}
.data-grid-hero {
  position: relative;
  overflow: hidden;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.grid-container {
  position: absolute; inset: 0;
  display: grid;
  pointer-events: none;
  z-index: 0;
}
.grid-container::after {
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(
    circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
    rgba(129,215,19,0.12) 0%,
    transparent 55%
  );
  opacity: var(--mouse-glow-opacity, 0);
  pointer-events: none;
  transition: opacity 0.3s;
}
.grid-cell {
  border-radius: 2px;
  opacity: var(--opacity-min, 0.03);
}
.hero-content {
  position: relative; z-index: 1;
}

/* ====== GRAIN OVERLAY ====== */
body::after {
  content: '';
  position: fixed; inset: 0; z-index: 9999;
  pointer-events: none;
  opacity: 0.028;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 200px 200px;
}

/* ====== HERO ====== */
.hero {
  position: relative; padding: 96px 32px 120px;
  overflow: hidden; border-bottom: 1px solid rgba(255,255,255,0.05);
  background: var(--green-900);
}
/* Vignette bottom fade */
.hero::after {
  content: '';
  position: absolute; bottom: 0; left: 0; right: 0; height: 200px;
  background: linear-gradient(to top, rgba(5,15,9,0.7), transparent);
  pointer-events: none; z-index: 0;
}
/* Astro island wrapper must not participate in flow */
.hero > astro-island {
  position: absolute; inset: 0;
  pointer-events: none; z-index: 0;
}
.hero-inner {
  max-width: 1280px; margin: 0 auto; position: relative; z-index: 1;
  display: grid; grid-template-columns: 1.15fr 1fr; gap: 80px; align-items: center;
}
.eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: 'JetBrains Mono', monospace; font-size: 12px;
  letter-spacing: 0.08em; color: var(--green-300); text-transform: uppercase;
  padding: 6px 12px; background: rgba(129,215,19,0.12); border-radius: 2px;
  border: 1px solid rgba(129,215,19,0.2); margin-bottom: 28px;
}
.eyebrow .dot {
  width: 6px; height: 6px; background: var(--green-300); border-radius: 50%;
  animation: pulseDot 2s infinite;
}
@keyframes pulseDot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%       { opacity: 0.35; transform: scale(0.75); }
}
h1.hero-h1 {
  font-family: 'Inter', sans-serif; font-weight: 800;
  font-size: clamp(38px, 5vw, 62px); line-height: 1.08;
  letter-spacing: -0.035em; color: #fff;
  margin-bottom: 22px; max-width: 720px; text-wrap: balance;
}
h1.hero-h1 em { font-style: normal; color: var(--green-300); font-weight: 800; }
.hero-sub {
  font-size: 17px; color: rgba(235,234,228,0.82); max-width: 500px;
  margin-bottom: 36px; line-height: 1.65;
  font-weight: 400;
}
.hero-ctas { display: flex; gap: 12px; margin-bottom: 40px; flex-wrap: wrap; }
.hero .btn { background: var(--green-300); color: var(--green-900); border-color: var(--green-300); font-weight: 600; }
.hero .btn:hover { background: var(--green-300-hover); border-color: var(--green-300-hover); box-shadow: 0 4px 24px rgba(129,215,19,0.35); }
.hero .btn-ghost { background: transparent; color: rgba(245,244,238,0.85); border-color: rgba(245,244,238,0.25); }
.hero .btn-ghost:hover { background: rgba(245,244,238,0.08); color: var(--cream); }
.trust-row {
  display: flex; gap: 28px; flex-wrap: wrap;
  font-size: 13.5px; color: rgba(250,250,245,0.80);
}
.trust-row span { display: inline-flex; align-items: center; gap: 8px; }
.trust-row svg { width: 14px; height: 14px; color: var(--green-300); flex-shrink: 0; }

/* Conductor Mockup */
.conductor-mockup {
  background: rgba(5,18,12,0.55);
  backdrop-filter: blur(24px) saturate(1.8);
  -webkit-backdrop-filter: blur(24px) saturate(1.8);
  border: 1px solid rgba(129,215,19,0.22);
  border-radius: 14px;
  box-shadow: 0 1px 0 rgba(129,215,19,0.12) inset,
              0 0 0 1px rgba(129,215,19,0.06),
              0 40px 80px -20px rgba(0,0,0,0.6),
              0 8px 24px -4px rgba(0,0,0,0.35);
  overflow: hidden; font-size: 12px;
  transform: perspective(2000px) rotateY(-3deg) rotateX(2deg);
  transition: transform .4s cubic-bezier(0.22,1,0.36,1);
  position: relative; z-index: 2;
}
.conductor-mockup:hover {
  transform: perspective(2000px) rotateY(-1deg) rotateX(1deg) translateY(-4px);
}
.mockup-titlebar {
  padding: 10px 14px; background: rgba(0,0,0,0.25); border-bottom: 1px solid rgba(129,215,19,0.1);
  display: flex; align-items: center; gap: 10px;
  font-family: 'JetBrains Mono', monospace; font-size: 11px; color: rgba(129,215,19,0.4);
}
.mockup-titlebar .dots { display: flex; gap: 5px; }
.mockup-titlebar .dot-c { width: 9px; height: 9px; border-radius: 50%; background: rgba(255,255,255,0.1); }
.mockup-body { padding: 18px 20px; background: transparent; }
.mockup-row {
  display: flex; align-items: center; padding: 10px 0;
  border-bottom: 1px solid rgba(129,215,19,0.08); gap: 14px;
}
.mockup-row:last-child { border-bottom: none; }
.mock-icon {
  width: 28px; height: 28px; border-radius: 4px;
  background: rgba(129,215,19,0.12); color: var(--green-300);
  display: flex; align-items: center; justify-content: center;
  font-weight: 600; font-size: 11px; flex-shrink: 0;
}
.mock-icon.indici { background: rgba(184,101,31,0.15); color: #C4855A; }
.mock-icon.s3 { background: rgba(83,69,163,0.15); color: #8B7ED4; }
.mock-icon.db { background: rgba(129,215,19,0.12); color: var(--green-300); }
.mock-flow {
  flex: 1; font-family: 'JetBrains Mono', monospace;
  font-size: 11.5px; color: rgba(250,250,245,0.72);
  display: flex; align-items: center; gap: 10px;
}
.mock-arrow { color: rgba(129,215,19,0.4); }
.mock-status {
  padding: 3px 9px; border-radius: 2px;
  font-size: 10px; font-weight: 500; letter-spacing: 0.02em; white-space: nowrap;
}
.mock-status.running {
  background: rgba(129,215,19,0.12); color: var(--green-300);
  display: inline-flex; align-items: center; gap: 5px;
}
.mock-status.running::before {
  content: ''; width: 5px; height: 5px; border-radius: 50%;
  background: var(--green-300); animation: pulseDot 1.5s infinite;
}
.mock-status.queued { background: rgba(255,255,255,0.05); color: rgba(250,250,245,0.35); }
.mockup-foot {
  padding: 12px 20px; background: rgba(0,0,0,0.2); border-top: 1px solid rgba(129,215,19,0.08);
  font-family: 'JetBrains Mono', monospace; font-size: 11px; color: rgba(129,215,19,0.35);
  display: flex; justify-content: space-between;
}
.mockup-foot .live {
  color: var(--green-300); display: inline-flex; align-items: center; gap: 5px;
}
.mockup-foot .live::before {
  content: ''; width: 6px; height: 6px; border-radius: 50%;
  background: var(--green-300); animation: pulseDot 1.5s infinite;
}

/* ====== TRUST BAND ====== */
.trust-band { background: var(--cream-2); padding: 48px 32px; border-bottom: 1px solid var(--line-soft); }
.trust-band-inner { max-width: 1280px; margin: 0 auto; text-align: center; }
.trust-band-label {
  font-family: 'JetBrains Mono', monospace; font-size: 12px;
  letter-spacing: 0.08em; color: var(--muted); text-transform: uppercase; margin-bottom: 28px;
}
.stats-row {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 0; background: transparent; border: none;
  border-radius: 0; overflow: visible;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
.stat {
  background: transparent;
  border-right: 1px solid var(--line);
  padding: 32px 28px; text-align: left;
  transition: background .2s;
}
.stat:last-child { border-right: none; }
.stat:hover { background: rgba(255,255,255,0.5); }
.stat-num {
  font-family: 'Inter', sans-serif; font-size: 40px; color: var(--green-900); font-weight: 800;
  line-height: 1; margin-bottom: 6px; letter-spacing: -0.04em; font-variant-numeric: tabular-nums;
}
.stat-label { font-size: 13px; color: var(--ink-2); }

/* ====== SECTIONS ====== */
section.standard { padding: 110px 32px; border-bottom: 1px solid var(--line-soft); position: relative; }
section.standard:not(.platform-section) {
  background:
    radial-gradient(ellipse 80% 60% at 20% 50%, rgba(129,215,19,0.06) 0%, transparent 60%),
    radial-gradient(ellipse 60% 80% at 80% 20%, rgba(220,239,230,0.08) 0%, transparent 55%),
    var(--cream);
}
.trust-band {
  background:
    radial-gradient(ellipse 70% 100% at 50% 0%, rgba(129,215,19,0.07) 0%, transparent 60%),
    var(--cream-2) !important;
}
.customer-section {
  background:
    radial-gradient(ellipse 90% 60% at 10% 50%, rgba(129,215,19,0.07) 0%, transparent 55%),
    radial-gradient(ellipse 60% 80% at 90% 80%, rgba(220,239,230,0.1) 0%, transparent 50%),
    var(--cream-2) !important;
}
.companies-band {
  background:
    radial-gradient(ellipse 80% 100% at 50% 50%, rgba(129,215,19,0.05) 0%, transparent 65%),
    var(--cream);
}
.section-inner { max-width: 1280px; margin: 0 auto; }
.section-head { display: grid; grid-template-columns: 0.4fr 1fr; gap: 60px; margin-bottom: 64px; }
.section-eyebrow {
  font-family: 'JetBrains Mono', monospace; font-size: 12px;
  letter-spacing: 0.1em; color: var(--green-700); text-transform: uppercase;
  padding-top: 10px; border-top: 1px solid var(--green-700); display: inline-block; align-self: start;
}
h2.section-h2 {
  font-family: 'Inter', sans-serif; font-weight: 800;
  font-size: clamp(32px, 3.8vw, 50px); line-height: 1.08; letter-spacing: -0.035em;
  color: var(--ink); max-width: 760px; text-wrap: balance;
}
h2.section-h2 em { font-style: normal; color: var(--green-600); font-weight: 800; }

/* ====== PROBLEM ====== */
.problem-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.problem-card {
  background: #fff;
  border: 1px solid var(--line);
  padding: 36px 32px; border-radius: 4px;
  transition: border-color .2s, transform .25s, box-shadow .25s;
  position: relative; overflow: hidden;
}
.problem-card::after {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: var(--green-300);
  transform: scaleX(0); transform-origin: left;
  transition: transform .3s cubic-bezier(0.22,1,0.36,1);
}
.problem-card:hover {
  border-color: var(--line);
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(8,12,10,0.1);
}
.problem-card:hover::after { transform: scaleX(1); }
.problem-num { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--muted); margin-bottom: 20px; letter-spacing: 0.05em; }
.problem-h3 {
  font-family: 'Inter', sans-serif; font-weight: 700; font-size: 19px;
  color: var(--ink); margin-bottom: 12px; line-height: 1.08; letter-spacing: -0.035em;
}
.problem-card p { font-size: 14.5px; color: var(--ink-2); line-height: 1.6; }

/* ====== PLATFORM ====== */
.platform-section { background: var(--green-900); color: var(--cream); border-bottom: 1px solid rgba(255,255,255,0.05); }
.platform-section .section-eyebrow { color: var(--green-300); border-top-color: var(--green-300); }
.platform-section .section-h2 { color: var(--cream); }
.platform-section .section-h2 em { color: var(--green-300); }
.platform-intro { font-size: 17px; color: rgba(250,250,245,0.72); max-width: 600px; margin-bottom: 56px; line-height: 1.65; }
.pillars {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;
  border: none; border-radius: 0; overflow: visible;
}
.pillar {
  padding: 36px 36px 36px 32px; border-radius: 4px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.07);
  border-left: 3px solid rgba(129,215,19,0.35);
  transition: border-left-color .25s, transform .25s, background .25s;
  position: relative;
}
.pillar::before {
  content: '';
  position: absolute; inset: 0; border-radius: 4px;
  background: linear-gradient(135deg, rgba(129,215,19,0.04) 0%, transparent 60%);
  pointer-events: none;
}
.pillar:hover {
  background: rgba(255,255,255,0.06);
  border-left-color: var(--green-300);
  transform: translateY(-2px);
}
.pillar-num { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--green-300); margin-bottom: 20px; }
.pillar-h { font-family: 'Inter', sans-serif; font-size: 20px; font-weight: 700; color: var(--cream); margin-bottom: 12px; line-height: 1.08; letter-spacing: -0.035em; }
.pillar p { font-size: 14.5px; color: rgba(250,250,245,0.62); line-height: 1.6; }
.pillar code {
  font-family: 'JetBrains Mono', monospace; font-size: 12px;
  color: var(--green-300); background: rgba(129,215,19,0.1); padding: 1px 5px; border-radius: 2px;
}
.platform-cta { margin-top: 56px; display: flex; gap: 14px; flex-wrap: wrap; }
.platform-section .btn-ghost { color: var(--cream); border-color: rgba(250,250,245,0.35); }
.platform-section .btn-ghost:hover { background: var(--cream); color: var(--green-900); border-color: var(--cream); }

/* ====== HOW IT WORKS ====== */
.how-flow { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; border: none; background: transparent; }
.how-step {
  padding: 40px 36px; border-right: none; border-radius: 4px;
  background: #fff;
  border: 1px solid var(--line);
  transition: transform .25s, box-shadow .25s;
  position: relative;
}
.how-step:hover { transform: translateY(-3px); box-shadow: 0 12px 40px rgba(8,12,10,0.1); }
.step-num {
  font-family: 'Inter', sans-serif; font-size: 42px; font-weight: 800;
  color: var(--line); letter-spacing: -0.035em;
  margin-bottom: 20px; line-height: 1;
}

.step-h { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 22px; color: var(--ink); margin-bottom: 14px; line-height: 1.08; letter-spacing: -0.035em; }
.how-step p { font-size: 14.5px; color: var(--ink-2); margin-bottom: 20px; line-height: 1.6; }
.step-time {
  font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: var(--green-700);
  padding: 4px 10px; background: var(--green-100); border-radius: 2px; display: inline-block;
}

/* ====== SOLUTIONS ====== */
.solutions-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.solution-card {
  background: #fff;
  border: 1px solid var(--line);
  padding: 40px 32px; border-radius: 4px;
  transition: border-color .2s, transform .25s, box-shadow .25s;
  display: flex; flex-direction: column; min-height: 300px;
}
.solution-card:hover {
  border-color: var(--green-600);
  transform: translateY(-3px);
  box-shadow: 0 12px 40px rgba(8,12,10,0.1);
}
.solution-tag { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.06em; color: var(--muted); text-transform: uppercase; margin-bottom: 20px; }
.solution-h { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 21px; color: var(--ink); margin-bottom: 14px; line-height: 1.08; letter-spacing: -0.035em; }
.solution-card p { font-size: 14.5px; color: var(--ink-2); flex: 1; margin-bottom: 24px; line-height: 1.6; }
.solution-link { color: var(--green-700); font-size: 14px; font-weight: 500; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: gap .2s; }
.solution-link:hover { gap: 14px; }

/* ====== CUSTOMERS ====== */
.customer-section { background: var(--cream-2); }
.customer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.customer-card {
  background: #fff;
  border: 1px solid var(--line);
  padding: 40px 32px; border-radius: 4px;
  transition: border-color .2s, transform .25s, box-shadow .25s;
  display: flex; flex-direction: column;
  /* reset blockquote browser defaults */
  margin: 0;
}
.customer-card:hover {
  border-color: var(--green-600);
  transform: translateY(-3px);
  box-shadow: 0 12px 40px rgba(8,12,10,0.1);
}
.customer-card::before {
  content: '\201C';
  display: block; font-size: 52px; line-height: 0.8;
  color: var(--green-300); margin-bottom: 20px;
  font-family: Georgia, 'Times New Roman', serif; font-weight: 700;
}
.customer-quote {
  font-size: 14.5px; line-height: 1.6; color: var(--ink-2);
  margin-bottom: 24px; flex: 1; font-weight: 400; font-style: italic;
}
.customer-meta {
  display: flex; align-items: center; gap: 12px;
  padding-top: 20px; border-top: 1px solid var(--line-soft);
}
.customer-avatar {
  width: 40px; height: 40px; border-radius: 50%;
  background: var(--green-700); color: var(--cream);
  display: flex; align-items: center; justify-content: center;
  font-weight: 600; font-size: 13px; flex-shrink: 0;
}
.customer-name { font-size: 14px; font-weight: 600; color: var(--ink); line-height: 1.3; font-style: normal; }
.customer-role { font-size: 12px; color: var(--muted); line-height: 1.4; margin-top: 2px; }
.customer-outcome {
  margin-top: 20px;
  font-family: 'JetBrains Mono', monospace; font-size: 11px;
  letter-spacing: 0.06em; color: var(--muted); text-transform: uppercase;
}

/* ====== SECURITY ====== */
.security-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
.security-pillars { display: flex; flex-direction: column; }
.sec-item { padding: 28px 0; border-bottom: 1px solid var(--line-soft); display: grid; grid-template-columns: 36px 1fr; gap: 20px; }
.sec-item:last-child { border-bottom: none; }
.sec-icon { width: 36px; height: 36px; color: var(--green-700); flex-shrink: 0; }
.sec-h { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 17px; color: var(--green-900); margin-bottom: 8px; letter-spacing: -0.01em; }
.sec-item p { font-size: 14.5px; color: var(--ink-2); line-height: 1.6; }
.badges {
  background: #fff;
  border: 1px solid var(--line);
  padding: 32px; border-radius: 4px; position: sticky; top: 100px;
  box-shadow: 0 4px 24px rgba(8,12,10,0.06);
}
.badges-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.08em; color: var(--muted); text-transform: uppercase; margin-bottom: 24px; }
.badges-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; background: transparent; border: none; margin-bottom: 24px; }
.badges-grid--single { grid-template-columns: 1fr; }
.badge {
  background: var(--cream);
  border: 1px solid var(--line);
  border-radius: 4px; padding: 20px 16px; text-align: center;
}
.badge-name { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 15px; color: var(--ink); margin-bottom: 4px; letter-spacing: -0.02em; }
.badge-desc { font-size: 12px; color: var(--muted); }

/* ====== CTA ====== */
.cta-section {
  background: var(--green-900); color: var(--cream);
  padding: 110px 32px; text-align: center; position: relative; overflow: hidden;
}
.cta-section::before {
  content: ''; position: absolute; inset: 0;
  background-image:
    linear-gradient(to right, rgba(129,215,19,0.05) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(129,215,19,0.05) 1px, transparent 1px);
  background-size: 64px 64px;
  mask-image: radial-gradient(ellipse 60% 60% at 50% 50%, black 30%, transparent 80%);
  -webkit-mask-image: radial-gradient(ellipse 60% 60% at 50% 50%, black 30%, transparent 80%);
  pointer-events: none;
}
.cta-inner { position: relative; max-width: 800px; margin: 0 auto; }
.cta-section h2 {
  font-family: 'Inter', sans-serif; font-weight: 800;
  font-size: clamp(32px, 5vw, 56px); color: #fff;
  line-height: 1.08; margin-bottom: 24px; letter-spacing: -0.035em; text-wrap: balance;
}
.cta-section h2 em { color: var(--green-300); font-style: normal; font-weight: 800; }
.cta-sub {
  font-size: 18px; color: rgba(250,250,245,0.72); margin-bottom: 40px;
  max-width: 540px; margin-left: auto; margin-right: auto; line-height: 1.65;
}
.cta-section .btn { background: var(--green-300); color: var(--green-900); border-color: var(--green-300); font-weight: 600; }
.cta-section .btn:hover { background: var(--green-300-hover); border-color: var(--green-300-hover); box-shadow: 0 4px 24px rgba(129,215,19,0.35); }
.cta-section .btn-ghost { background: transparent; color: rgba(245,244,238,0.85); border-color: rgba(245,244,238,0.25); }
.cta-section .btn-ghost:hover { background: rgba(245,244,238,0.08); color: var(--cream); }
.cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

/* ====== FOOTER ====== */
footer { background: var(--cream-2); padding: 80px 32px 40px; border-top: 1px solid var(--line); }
.footer-inner { max-width: 1280px; margin: 0 auto; }
.footer-top { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 48px; padding-bottom: 60px; border-bottom: 1px solid var(--line); }
.footer-brand-logo { margin-bottom: 20px; }
.footer-brand-logo img { height: 26px; width: auto; }
.footer-brand p { font-size: 14px; color: var(--ink-2); max-width: 300px; margin-bottom: 20px; line-height: 1.65; }
.footer-badges { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
.footer-badge {
  font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: 0.05em;
  padding: 5px 12px;
  background: rgba(129,215,19,0.12);
  border: 1px solid rgba(129,215,19,0.25);
  color: var(--green-700); border-radius: 100px;
}
.footer-linkedin { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); text-decoration: none; transition: color .15s; }
.footer-linkedin:hover { color: var(--green-700); }
.footer-col h4 { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.08em; color: var(--muted); text-transform: uppercase; margin-bottom: 20px; font-weight: 500; }
.footer-col a { display: block; font-size: 14px; color: var(--ink-2); text-decoration: none; padding: 6px 0; transition: color .15s; }
.footer-col a:hover { color: var(--green-700); }
.footer-bottom { padding-top: 32px; display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: var(--muted); flex-wrap: wrap; gap: 16px; }
.footer-bottom-links { display: flex; gap: 24px; align-items: center; }
.footer-bottom-links a { color: var(--muted); text-decoration: none; transition: color .15s; }
.footer-bottom-links a:hover { color: var(--green-700); }
.back-to-top { background: none; border: none; cursor: pointer; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.06em; color: var(--muted); text-transform: uppercase; display: inline-flex; align-items: center; gap: 6px; transition: color .15s; }
.back-to-top:hover { color: var(--green-700); }

/* ====== SCROLL REVEAL ====== */
.reveal {
  opacity: 0; transform: translateY(20px);
  transition: opacity .65s cubic-bezier(0.22,1,0.36,1), transform .65s cubic-bezier(0.22,1,0.36,1);
}
.reveal.in { opacity: 1; transform: translateY(0); }
.reveal-d1 { transition-delay: 0.1s; }
.reveal-d2 { transition-delay: 0.2s; }
.reveal-d3 { transition-delay: 0.3s; }
.reveal-d4 { transition-delay: 0.4s; }

/* ====== RESPONSIVE ====== */
@media (max-width: 1024px) {
  .hero-inner { grid-template-columns: 1fr; gap: 56px; }
  .conductor-mockup { transform: none !important; }
  .section-head { grid-template-columns: 1fr; gap: 20px; margin-bottom: 48px; }
  .footer-top { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 768px) {
  nav { padding: 14px 20px; }
  .nav-links, .nav-signin { display: none; }
  .nav-hamburger { display: flex; }
  .hero { padding: 64px 20px 84px; }
  section.standard, .cta-section { padding: 80px 20px; }
  .trust-band { padding: 40px 20px; }
  .stats-row { grid-template-columns: 1fr 1fr; }
  .problem-grid, .solutions-grid, .customer-grid { grid-template-columns: 1fr; }
  .how-flow { grid-template-columns: 1fr; }
  .how-step { border-right: none; }
  .pillars { grid-template-columns: 1fr; }
  .pillar { border-right: none !important; }
  .security-grid { grid-template-columns: 1fr; gap: 40px; }
  .badges { position: static; }
  .footer-top { grid-template-columns: 1fr; gap: 32px; }
  .footer-bottom { flex-direction: column; align-items: flex-start; gap: 12px; }
  .cta-btns { flex-direction: column; align-items: center; }
  .trust-row { gap: 16px; }
}
@media (max-width: 480px) {
  .stats-row { grid-template-columns: 1fr; }
  h1.hero-h1 { font-size: 36px; }
  nav, .hero, section.standard, .cta-section, .trust-band, .companies-band, footer {
    padding-left: max(16px, 5vw);
    padding-right: max(16px, 5vw);
  }
}

/* ====== COMPANIES BAND ====== */
.companies-band { background: var(--cream); padding: 60px 32px; border-bottom: 1px solid var(--line-soft); }
.companies-band-inner { max-width: 1280px; margin: 0 auto; text-align: center; }
.companies-band-label {
  font-family: 'JetBrains Mono', monospace; font-size: 12px;
  letter-spacing: 0.08em; color: var(--muted); text-transform: uppercase; margin-bottom: 40px;
}
.companies-grid {
  display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; align-items: center;
}
.company-tile {
  font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 500;
  color: var(--ink-2); padding: 12px 28px;
  background: rgba(255,255,255,0.58);
  backdrop-filter: blur(12px) saturate(1.6);
  -webkit-backdrop-filter: blur(12px) saturate(1.6);
  border: 1px solid rgba(255,255,255,0.82);
  border-radius: 100px;
  box-shadow: 0 1px 0 rgba(255,255,255,0.95) inset, 0 4px 16px rgba(11,51,41,0.05);
  letter-spacing: -0.01em;
  transition: border-color .25s, color .25s, transform .25s, box-shadow .25s;
}
.company-tile:hover {
  border-color: rgba(129,215,19,0.6);
  color: var(--green-700);
  transform: translateY(-3px);
  box-shadow: 0 1px 0 rgba(255,255,255,0.95) inset, 0 8px 28px rgba(27,101,83,0.1);
}

/* ====== REDUCED MOTION ====== */
@media (prefers-reduced-motion: reduce) {
  .reveal { transition: none; opacity: 1; transform: none; }
  .light-beam { animation: none; opacity: 0.08; }
  .eyebrow .dot, .mock-status.running::before, .mockup-foot .live::before { animation: none; }
  .conductor-mockup { transition: none; }
  * { scroll-behavior: auto !important; }
}
</style>
</head>
