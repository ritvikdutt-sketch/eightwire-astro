---
import LandingLayout from '../layouts/LandingLayout.astro';
import PageHero from '../components/landing/PageHero.tsx';
import Security from '../components/landing/Security.tsx';
import CTASection from '../components/landing/CTASection.tsx';

// Verbatim from eightwire.io/conductor ("Why Eightwire Conductor — Compliant").
const lede = 'We meet user access, data sovereignty, governance, privacy, and security requirements out of the box.';
---
<LandingLayout title="Security & trust — Eightwire" description={lede}>
  <PageHero eyebrow="Security & trust" lede={lede}>
    Built for the <em class="text-lime">strictest</em> procurement teams in the country
  </PageHero>
  <Security showHead={false} />
  <CTASection />
</LandingLayout>
