---
import LandingLayout from '../layouts/LandingLayout.astro';
import PageHero from '../components/landing/PageHero.tsx';
import SectionHead from '../components/landing/SectionHead.tsx';
import CTASection from '../components/landing/CTASection.tsx';
import { arrowNudge, focusForest } from '../components/landing/ui';
import { CONTACT_EMAIL } from '../components/landing/cta';

const base = import.meta.env.BASE_URL;

// Copy carried over verbatim from eightwire.io/support; the six FAQs now live on /faq/.
const COMMITMENT =
  "At Eightwire, we are trusted by over 100 public and private organisations to handle high-stakes data, everyday. That's why we have ensured that data exchange with Eightwire products goes above and beyond the highest security thresholds, to keep your sensitive data safe.";

const CHANNELS = [
  {
    eyebrow: 'Self-serve',
    title: 'Knowledge base',
    body: 'Learning resources to get you started using Eightwire, for administrators and end-users.',
    link: 'Browse the knowledge base',
    href: `${base}knowledge-base/`,
  },
  {
    eyebrow: 'Quick answers',
    title: 'Frequently asked questions',
    body: 'What a data exchange is, how secure it is, where your data is stored and how long integration takes.',
    link: 'Read the FAQ',
    href: `${base}faq/`,
  },
  {
    eyebrow: 'Talk to a person',
    title: 'Email support',
    body: 'Product questions, account help and anything the guides do not cover. One address reaches the whole team.',
    link: CONTACT_EMAIL,
    href: `mailto:${CONTACT_EMAIL}`,
  },
];
---
<LandingLayout
  title="Support — Eightwire"
  description="Get support for Eightwire's secure data exchange products: knowledge base guides, frequently asked questions and email support."
>
  <PageHero
    eyebrow="Resources · Support"
    lede="Eightwire products provide a safe, secure and easy method for connecting people and organisations."
  >
    We help you unlock the <em class="text-lime">power of your data</em>
  </PageHero>

  <section
    class="border-b border-cream-line py-24 sm:py-28"
    style="background: radial-gradient(ellipse 80% 60% at 15% 40%, rgba(129,215,19,0.06) 0%, transparent 60%), #F5F4EE;"
  >
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <SectionHead eyebrow="Data exchange you can trust" lede={COMMITMENT}>
        We understand the importance of <em class="text-forest">automated and secure</em> data sharing
      </SectionHead>

      <div class="border-t border-cream-line">
        {CHANNELS.map((c, i) => (
          <article class={`reveal reveal-d${i % 3} grid gap-5 border-b border-cream-line py-10 lg:grid-cols-[0.38fr_1fr] lg:gap-14 lg:py-12`}>
            <div>
              <p class="font-mono text-caption uppercase tracking-[0.14em] text-ink-muted">{c.eyebrow}</p>
              <h3 class="mt-3 font-display text-[clamp(1.5rem,2.4vw,2rem)] leading-[1.15] tracking-[-0.01em] text-ink">{c.title}</h3>
            </div>
            <div class="max-w-2xl">
              <p class="text-body-lg leading-[1.75] text-ink-soft">{c.body}</p>
              <a href={c.href} class={`group mt-7 inline-flex items-center gap-2 text-body-sm font-medium text-forest transition-colors duration-200 hover:text-forest-dark ${focusForest}`}>
                {c.link} <span aria-hidden="true" class={arrowNudge}>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</LandingLayout>
